{erl_opts, [
    debug_info,
    {i, "include"},
    {i, "src"},
    {i, "src/emulator"},
    {i, "src/cpu"}
]}.

{deps, []}.

%% Ship the LICENSE file with every build: copy it into the built app's priv
%% (dev/test/prod all compile through this hook, and the release bundles the
%% compiled app), so the About dialog can link to it via file:// without the
%% file living in the source priv directory.
{post_hooks, [
    {"unix", compile, "cp LICENSE \"$REBAR_BUILD_DIR/lib/ezx/priv/LICENSE\""},
    {"win32", compile, "copy LICENSE \"%REBAR_BUILD_DIR%\\lib\\ezx\\priv\\LICENSE\""}
]}.

{include_dirs, ["include"]}.

{eunit_opts, [verbose]}.

{cover_enabled, true}.
{cover_opts, [verbose]}.

{profiles, [
    {test, [
        {extra_src_dirs, ["test/z80", "test/video"]}
    ]}
]}.
{shell, [
    {apps, [ezx]}
    % {config, "./config/sys.config"}
]}.

{relx, [
    {release, {ezx, "1.2.0"}, [ezx]},
    {mode, prod},
    {include_erts, true},
    {extended_start_script, true},
    {sys_config, "./config/sys.config"},
    {vm_args, "./config/vm.args"},
    {overlay, [
        {copy, "scripts/ezx-launch", "bin/ezx-launch"},
        {copy, "scripts/ezx-launch.cmd", "bin/ezx-launch.cmd"},
        {copy, "scripts/ezx-launch.vbs", "bin/ezx-launch.vbs"},
        {copy, "scripts/install-startmenu.ps1", "bin/install-startmenu.ps1"},
        {copy, "scripts/uninstall-startmenu.ps1", "bin/uninstall-startmenu.ps1"},
        {copy, "LICENSE", "lib/ezx/priv/LICENSE"}
    ]}
]}.